<launch>
  <!-- New perception only; learned object heads require training. -->
  <arg name="image_topic" default="/magv/camera/image_compressed/compressed" />
  <arg name="cloud_topic" default="/magv/scan/3d" />
  <arg name="camera_info_topic" default="/magv/camera/camera_info" />
  <arg name="robot_frame" default="base_link" />
  <arg name="fixed_frame" default="odom" />
  <arg name="resolution" default="0.1" />
  <arg name="sync_slop" default="0.05" />
  <node name="bev_features_node" pkg="goal_detection" type="bev_features_node.py" output="screen">
    <param name="image_topic" value="$(arg image_topic)" />
    <param name="cloud_topic" value="$(arg cloud_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="robot_frame" value="$(arg robot_frame)" />
    <param name="fixed_frame" value="$(arg fixed_frame)" />
    <param name="resolution" value="$(arg resolution)" />
    <param name="sync_slop" value="$(arg sync_slop)" />
  </node>
</launch>
